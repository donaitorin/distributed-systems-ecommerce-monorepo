# Demo values for local development only. Copy to .env and change anything shared.

POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=demo-superuser-change-me
POSTGRES_HOST_PORT=15432

AUTH_DB_PASSWORD=demo-auth-db
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=demo-admin-change-me
DEV_CUSTOMER_EMAIL=dev-customer@example.com
DEV_CUSTOMER_PASSWORD=demo-customer-change-me
ACCOUNTS_DB_PASSWORD=demo-accounts-db
CATALOG_DB_PASSWORD=demo-catalog-db
CATALOG_DB_HOST=127.0.0.1
CATALOG_DB_PORT=15432
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_SEARCH_TIMEOUT_MS=2000
IMPORT_MAX_BYTES=52428800
ORDERS_DB_PASSWORD=demo-orders-db
ORDERS_SAGA_TIMEOUT_SECONDS=60
ORDERS_SAGA_SWEEP_INTERVAL_SECONDS=5
PAYMENT_LATE_APPROVAL_DELAY_SECONDS=90
PAYMENTS_SETTLE_INTERVAL_SECONDS=2
PAYMENTS_DB_PASSWORD=demo-payments-db

REDIS_CART_PASSWORD=demo-redis-cart
REDIS_CART_HOST_PORT=16379
CART_CATALOG_TIMEOUT_SECONDS=2
CART_CATALOG_BREAKER_FAILURE_THRESHOLD=5
CART_CATALOG_BREAKER_OPEN_SECONDS=10
CART_CATALOG_BREAKER_HALF_OPEN_PROBES=1
CART_CATALOG_RETRY_ATTEMPTS=2
REDIS_CACHE_PASSWORD=demo-redis-cache
REDIS_CACHE_HOST_PORT=16380

KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_HOST_PORT=8088

OBJECT_STORAGE_ACCESS_KEY=demo-access-key
OBJECT_STORAGE_SECRET_KEY=demo-secret-key-change-me
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_MEDIA_BUCKET=media
OBJECT_STORAGE_IMPORTS_BUCKET=imports
OBJECT_STORAGE_HOST_PORT=19000
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
MEDIA_PUBLIC_BASE_URL=/media

BUILDX_NO_DEFAULT_ATTESTATIONS=1

GATEWAY_HTTP_PORT=8000
GATEWAY_DASHBOARD_PORT=8001

AUTH_COOKIE_SECURE=false
JWT_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/.well-known/jwks.json
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_JWKS_CACHE_TTL_SECONDS=300
