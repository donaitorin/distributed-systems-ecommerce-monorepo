          "id",
          "customer_id",
          "status",
          "total",
          "currency",
          "item_count",
          "created_at",
          "updated_at"
        ],
        "title": "OrderSummaryOut",
        "type": "object"
      },
      "PaymentIn": {
        "properties": {
          "card_number": {
            "description": "Simulated card number. Only the last 4 digits are kept",
