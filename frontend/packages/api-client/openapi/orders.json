                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            },
            "description": "Invalid request data, or an idempotency key reused with a different body"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get any order (admin)",
        "tags": [
          "admin orders"
        ]
      }
    },
    "/api/v1/orders": {
      "get": {
        "operationId": "list_orders_api_v1_orders_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
