                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line2"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "postal_code": {
            "title": "Postal Code",
            "type": "string"
          },
          "recipient_name": {
            "title": "Recipient Name",
